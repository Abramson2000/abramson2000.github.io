/tingli/index.html
  Cache-Control: no-cache

/tingli/manifest.json
  Cache-Control: no-cache

/tingli/tingli-icon-*.png
  Cache-Control: public, max-age=31536000, immutable

/tingli/tingli-favicon.png
  Cache-Control: public, max-age=31536000, immutable


/tingli/audio/*
  Cache-Control: public, max-age=3600

# Сервис-воркеры: никогда не кэшировать сам sw.js, иначе браузер держит старую
# версию приложения и обновление не приходит (случай десктопного Safari на v1.1.1).
/sw.js
  Cache-Control: no-store, must-revalidate

/tingli/sw.js
  Cache-Control: no-store, must-revalidate

/cidian/sw.js
  Cache-Control: no-store, must-revalidate

/spin/sw.js
  Cache-Control: no-store, must-revalidate
